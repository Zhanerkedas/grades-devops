{
  "title": "Grades IS",
  "uid": "grades",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "БД доступна",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "grades_db_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Студентов",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "grades_students",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Дисциплин",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "grades_disciplines",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Средний балл",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "grades_average_score",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Запросов в секунду",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "sum(rate(grades_http_requests_total[1m])) by (endpoint)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ошибки 5xx",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "expr": "increase(grades_http_errors_total[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}